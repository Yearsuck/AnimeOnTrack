{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnimeOnTrack",
  "version": "0.2.0",
  "identifier": "com.ernes.aot-scaffold",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AnimeOnTrack",
        "width": 1280,
        "height": 832,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ernest Rull Turigas",
    "copyright": "© 2026 Ernest Rull Turigas",
    "category": "Entertainment",
    "homepage": "https://github.com/Yearsuck/AnimeOnTrack",
    "shortDescription": "Track currently-airing anime and get notified when new episodes drop.",
    "longDescription": "AnimeOnTrack tracks currently-airing anime across multiple streaming sites, detects new episodes for the series you follow, and keeps a gap-free record of what you've watched — with a full local AniList catalog for offline browsing and discovery.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
